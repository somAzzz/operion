# Server-only upstream. Never expose OPERION_AGENT_TOKEN with NEXT_PUBLIC_*.
OPERION_ENVIRONMENT=local
# In enterprise mode, the trusted gateway resolves an opaque server-side session
# and injects x-forwarded-access-token. No browser token-cookie fallback.
# Next.js must be private to that gateway. Static upstream tokens are ignored.
OPERION_PUBLIC_ORIGIN=https://operion.localhost:8443
OPERION_AGENT_URL=http://127.0.0.1:8000/api/agent
OPERION_AGENT_TOKEN=replace-with-a-long-random-value

# Server-only action-control connection. The browser receives neither value.
OPERION_ACTION_URL=http://127.0.0.1:8001/api
OPERION_ACTION_TOKEN=replace-with-a-separate-action-service-token
OPERION_ACTION_CSRF_TOKEN=replace-with-a-separate-csrf-token
OPERION_TWENTY_WEB_URL=http://localhost:3000
